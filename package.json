{
  "name": "github-actions-onboarding",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A small TypeScript project for hands-on GitHub Actions onboarding.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build": "tsc -p tsconfig.json",
    "check": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.13",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
